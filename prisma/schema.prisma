generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────
enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PlanInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  EXPIRED
}

enum MovementType {
  SALE
  RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum RequisitionStatus {
  DRAFT
  APPROVED
  REJECTED
  ORDERED
}

enum OrderStatus {
  PENDING
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  POS_CARD
  BANK_TRANSFER
  OTHER
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SaleStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  SUBSCRIPTION_EXPIRY
  SUBSCRIPTION_RENEWAL
  REPORT_READY
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  SYSTEM_ALERT
  USER_WELCOME
  GENERAL
}

// ─── Identity & Access ─────────────────────────────────
model Role {
  roleId      Int     @id @default(autoincrement()) @map("role_id")
  roleName    String  @map("role_name") @db.VarChar(50)
  description String? @db.Text
  users       User[]

  @@map("ROLES")
}

model User {
  userId       Int        @id @default(autoincrement()) @map("user_id")
  fullName     String     @map("full_name") @db.VarChar(100)
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  passwordHash String     @map("password_hash")
  roleId       Int        @map("role_id")
  branchId     Int        @map("branch_id")
  status       UserStatus @default(ACTIVE)
  failedLogins Int        @default(0) @map("failed_logins")
  lockedUntil  DateTime?  @map("locked_until")
  createdAt    DateTime   @default(now()) @map("created_at")
  lastLogin    DateTime?  @map("last_login")
  carts              Cart[]                 @relation("CartCashier")
  role   Role   @relation(fields: [roleId], references: [roleId])
  branch Branch @relation(fields: [branchId], references: [branchId])

  sales                     Sale[]                @relation("cashier")
  recordedMovements         InventoryMovement[]   @relation("recordedBy")
  generatedReports          ReportLog[]
  loginAttempts             LoginAttempt[]
  auditLogs                 AuditLog[]
  sentNotifications         Notification[]
  purchaseRequisitions      PurchaseRequisition[]
  goodsReceiptsReceived     GoodsReceipt[]        @relation("receiver")
  salesReportsGenerated     SalesReport[]
  inventoryReportsGenerated InventoryReport[]
  financialReportsGenerated FinancialReport[]
  recordedExpenses          Expense[]             @relation("ExpenseRecorder")
  approvedExpenses          Expense[]             @relation("ExpenseApprover")

  @@map("USERS")
}

model LoginAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  success     Boolean
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  attemptedAt DateTime @default(now()) @map("attempted_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("LOGIN_ATTEMPTS")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("PASSWORD_RESET_TOKENS")
}

// ─── Organization ──────────────────────────────────────
model Branch {
  branchId   Int      @id @default(autoincrement()) @map("branch_id")
  branchName String   @map("branch_name") @db.VarChar(100)
  address    String?  @db.Text
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  users                User[]
  inventory            Inventory[]
  products        Product[]
  carts              Cart[]
  sales                Sale[]
  expenses             Expense[]
  inventoryMovements   InventoryMovement[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  subscriptions        TenantSubscription[]
  salesReports         SalesReport[]
  inventoryReports     InventoryReport[]
  financialReports     FinancialReport[]
  reportSchedules      ReportSchedule[]

  @@map("BRANCHES")
}

// ─── Catalog ───────────────────────────────────────────
model Category {
  categoryId   Int      @id @default(autoincrement()) @map("category_id")
  categoryName String   @map("category_name") @db.VarChar(100)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("CATEGORIES")
}

model ExpenseCategory {
  categoryId   Int      @id @default(autoincrement()) @map("category_id")
  categoryName String   @map("category_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  expenses Expense[]

  @@map("EXPENSE_CATEGORIES")
}

model Supplier {
  supplierId   Int      @id @default(autoincrement()) @map("supplier_id")
  supplierName String   @map("supplier_name") @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(100)
  address      String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("SUPPLIERS")
}

model Product {
  productId      Int      @id @default(autoincrement()) @map("product_id")
  productName    String   @map("product_name") @db.VarChar(100)
  categoryId     Int      @map("category_id")
  supplierId     Int?     @map("supplier_id")
  branchId        Int?      @map("branch_id")
  barcode        String?  @db.VarChar(50)
  sku            String?  @db.VarChar(50)
  description    String?  @db.Text
  costPrice      Decimal  @map("cost_price") @db.Decimal(10, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(10, 2)
  reorderLevel   Int      @default(0) @map("reorder_level")
  brandId        String?  @map("brand_id") @db.VarChar(50)
  unit           String?  @db.VarChar(20)
  wholesalePrice Decimal? @map("wholesale_price") @db.Decimal(10, 2)
  cartItems          CartItem[]
  taxRate        Decimal? @map("tax_rate") @db.Decimal(5, 2)
  discount       Decimal? @db.Decimal(10, 2)
  image          String?  @db.Text
  trackInventory Boolean  @default(true) @map("track_inventory")
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  
  purchaseOrders  PurchaseOrder[]
  branch          Branch?   @relation(fields: [branchId], references: [branchId])
  category Category  @relation(fields: [categoryId], references: [categoryId])
  supplier Supplier? @relation(fields: [supplierId], references: [supplierId])

  inventory            Inventory[]
  saleItems            SaleItem[]
  movements            InventoryMovement[]
  purchaseRequisitions PurchaseRequisition[]
  goodsReceipts        GoodsReceipt[]

  @@map("PRODUCTS")
}

// ─── Inventory ─────────────────────────────────────────
model Inventory {
  inventoryId Int      @id @default(autoincrement()) @map("inventory_id")
  productId   Int      @map("product_id")
  branchId    Int      @map("branch_id")
  quantity    Int      @default(0)
  lastUpdated DateTime @updatedAt @map("last_updated")

  product Product @relation(fields: [productId], references: [productId])
  branch  Branch  @relation(fields: [branchId], references: [branchId])

  @@unique([productId, branchId])
  @@map("INVENTORY")
}

model InventoryMovement {
  movementId     Int          @id @default(autoincrement()) @map("movement_id")
  productId      Int          @map("product_id")
  branchId       Int          @map("branch_id")
  movementType   MovementType @map("movement_type")
  quantityChange Int          @map("quantity_change")
  quantityBefore Int          @map("quantity_before")
  quantityAfter  Int          @map("quantity_after")
  referenceId    Int?         @map("reference_id")
  referenceTable String?      @map("reference_table") @db.VarChar(50)
  recordedBy     Int          @map("recorded_by")
  note           String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  product  Product @relation(fields: [productId], references: [productId])
  branch   Branch  @relation(fields: [branchId], references: [branchId])
  recorder User    @relation("recordedBy", fields: [recordedBy], references: [userId])

  @@map("INVENTORY_MOVEMENTS")
}

// ─── Sales & Payments ──────────────────────────────────
model Sale {
  saleId        Int      @id @default(autoincrement()) @map("sale_id")
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(30)
  customerId    Int?     @map("customer_id")
  userId        Int      @map("user_id")
  branchId      Int      @map("branch_id")
  sessionId      String?   @db.VarChar(50) @map("session_id")
  saleDate      DateTime @default(now()) @map("sale_date")
  totalAmount   Decimal  @map("total_amount") @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  tax           Decimal  @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal  @map("grand_total") @db.Decimal(10, 2)
  status        SaleStatus @default(PENDING)
  posId         String?  @map("pos_id") @db.VarChar(50)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [customerId])
  cashier  User      @relation("cashier", fields: [userId], references: [userId])
  branch   Branch    @relation(fields: [branchId], references: [branchId])

  items    SaleItem[]
  payments Payment[]

  @@map("SALES")
}

model SaleItem {
  saleItemId Int      @id @default(autoincrement()) @map("sale_item_id")
  saleId     Int      @map("sale_id")
  productId  Int      @map("product_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  tax        Decimal? @db.Decimal(10, 2)
  discount   Decimal? @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [saleId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId])

  @@map("SALE_ITEMS")
}

model Payment {
  paymentId       Int           @id @default(autoincrement()) @map("payment_id")
  saleId          Int           @map("sale_id")
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(10,2)
  paymentDate     DateTime      @default(now()) @map("payment_date")
  referenceNumber String?       @db.VarChar(50) @map("reference_number")
  status          PaymentStatus @default(PAID)
  currency        String        @default("NGN") @db.VarChar(3)
  sale            Sale          @relation(fields: [saleId], references: [saleId], onDelete: Cascade)

  @@map("PAYMENTS")
}

// ─── Customer & Supplier Contacts ──────────────────────
model Customer {
  customerId    Int      @id @default(autoincrement()) @map("customer_id")
  name          String   @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(100)
  address       String?  @db.Text
  carts              Cart[]
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  balance       Decimal  @default(0) @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@map("CUSTOMERS")
}

// ─── Expenses ──────────────────────────────────────────
model Expense {
  expenseId     Int           @id @default(autoincrement()) @map("expense_id")
  branchId      Int           @map("branch_id")
  expenseNumber String        @unique @map("expense_number")
  categoryId    Int           @map("category_id")
  title         String        @map("expense_name") @db.VarChar(100)
  description   String?       @db.Text
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  reference     String?       @db.VarChar(50)
  attachment    String?       @db.Text
  status        ExpenseStatus @default(PENDING)
  expenseDate   DateTime      @map("expense_date")
  recordedBy    Int           @map("recorded_by")
  approvedBy    Int?          @map("approved_by")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  branch   Branch          @relation(fields: [branchId], references: [branchId])
  recorder User            @relation("ExpenseRecorder", fields: [recordedBy], references: [userId])
  approver User?           @relation("ExpenseApprover", fields: [approvedBy], references: [userId])
  category ExpenseCategory @relation(fields: [categoryId], references: [categoryId])

  @@map("EXPENSES")
}

// ─── Procurement ───────────────────────────────────────
model PurchaseRequisition {
  requisitionId Int               @id @default(autoincrement()) @map("requisition_id")
  branchId      Int               @map("branch_id")
  requestedBy   Int               @map("requested_by")
  productId     Int               @map("product_id")
  quantity      Int
  reason        String?           @db.Text
  status        RequisitionStatus @default(DRAFT)
  createdAt     DateTime          @default(now()) @map("created_at")

  branch         Branch          @relation(fields: [branchId], references: [branchId])
  requester      User            @relation(fields: [requestedBy], references: [userId])
  product        Product         @relation(fields: [productId], references: [productId])
  purchaseOrders PurchaseOrder[]

  @@map("PURCHASE_REQUISITIONS")
}

model PurchaseOrder {
  orderId       Int         @id @default(autoincrement()) @map("order_id")
  requisitionId Int?        @map("requisition_id")
  productId       Int       @map("product_id")
  quantity        Int
  supplierId    Int         @map("supplier_id")
  branchId      Int         @map("branch_id")
  status        OrderStatus @default(PENDING)
  orderDate     DateTime    @default(now()) @map("order_date")
  expectedDate  DateTime?   @map("expected_date")
  notes         String?     @db.Text

  product         Product   @relation(fields: [productId], references: [productId])
  supplier    Supplier             @relation(fields: [supplierId], references: [supplierId])
  branch      Branch               @relation(fields: [branchId], references: [branchId])
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [requisitionId])
  receipts    GoodsReceipt[]

  @@map("PURCHASE_ORDERS")
}

model GoodsReceipt {
  receiptId    Int      @id @default(autoincrement()) @map("receipt_id")
  orderId      Int      @map("order_id")
  productId    Int      @map("product_id")
  quantity     Int
  receivedBy   Int      @map("received_by")
  receivedDate DateTime @default(now()) @map("received_date")
  notes        String?  @db.Text

  order    PurchaseOrder @relation(fields: [orderId], references: [orderId])
  product  Product       @relation(fields: [productId], references: [productId])
  receiver User          @relation("receiver", fields: [receivedBy], references: [userId])

  @@map("GOODS_RECEIPTS")
}

// ─── Subscriptions ─────────────────────────────────────
model SubscriptionPlan {
  planId    Int                 @id @default(autoincrement()) @map("plan_id")
  name      String              @db.VarChar(50)
  interval  PlanInterval
  price     Decimal             @db.Decimal(10,2)
  features  String?             @db.Text
  isActive  Boolean             @default(true) @map("is_active")

  subscriptions TenantSubscription[]

  @@map("SUBSCRIPTION_PLANS")
}
model TenantSubscription {
  subscriptionId Int                @id @default(autoincrement()) @map("subscription_id")
  branchId       Int                @map("branch_id")
  planId         Int                @map("plan_id")
  startDate      DateTime           @map("start_date")
  endDate        DateTime           @map("end_date")
  status         SubscriptionStatus @default(TRIAL)
  graceUntil     DateTime?          @map("grace_until")
  createdAt      DateTime           @default(now()) @map("created_at")

  branch Branch           @relation(fields: [branchId], references: [branchId])
  plan   SubscriptionPlan @relation(fields: [planId], references: [planId])

  invoices SubscriptionInvoice[]

  @@map("TENANT_SUBSCRIPTIONS")
}

model SubscriptionInvoice {
  invoiceId      Int       @id @default(autoincrement()) @map("invoice_id")
  subscriptionId Int       @map("subscription_id")
  amount         Decimal   @db.Decimal(10, 2)
  dueDate        DateTime  @map("due_date")
  paidAt         DateTime? @map("paid_at")
  status         String    @default("unpaid") @db.VarChar(20)

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [subscriptionId])

  @@map("SUBSCRIPTION_INVOICES")
}

// ─── Reporting ─────────────────────────────────────────
model SalesReport {
  reportId          Int      @id @default(autoincrement()) @map("report_id")
  branchId          Int      @map("branch_id")
  reportDate        DateTime @map("report_date")
  totalSales        Decimal  @map("total_sales") @db.Decimal(12, 2)
  totalTransactions Int      @map("total_transactions")
  totalDiscount     Decimal  @map("total_discount") @db.Decimal(10, 2)
  totalTax          Decimal  @map("total_tax") @db.Decimal(10, 2)
  netSales          Decimal  @map("net_sales") @db.Decimal(12, 2)
  generatedAt       DateTime @default(now()) @map("generated_at")
  generatedBy       Int      @map("generated_by")

  branch    Branch @relation(fields: [branchId], references: [branchId])
  generator User   @relation(fields: [generatedBy], references: [userId])

  @@map("SALES_REPORT")
}

model InventoryReport {
  reportId        Int      @id @default(autoincrement()) @map("report_id")
  branchId        Int      @map("branch_id")
  reportDate      DateTime @map("report_date")
  totalProducts   Int      @map("total_products")
  totalStock      Int      @map("total_stock_quantity")
  totalValue      Decimal  @map("total_stock_value") @db.Decimal(12, 2)
  lowStockItems   Int      @map("low_stock_items")
  outOfStockItems Int      @map("out_of_stock_items")
  generatedAt     DateTime @default(now()) @map("generated_at")
  generatedBy     Int      @map("generated_by")

  branch    Branch @relation(fields: [branchId], references: [branchId])
  generator User   @relation(fields: [generatedBy], references: [userId])

  @@map("INVENTORY_REPORT")
}

model FinancialReport {
  reportId        Int      @id @default(autoincrement()) @map("report_id")
  branchId        Int      @map("branch_id")
  periodStart     DateTime @map("report_period_start")
  periodEnd       DateTime @map("report_period_end")
  totalSales      Decimal  @map("total_sales") @db.Decimal(12, 2)
  costOfGoodsSold Decimal  @map("cost_of_goods_sold") @db.Decimal(12, 2)
  grossProfit     Decimal  @map("gross_profit") @db.Decimal(12, 2)
  totalExpenses   Decimal  @map("total_expenses") @db.Decimal(12, 2)
  netProfit       Decimal  @map("net_profit") @db.Decimal(12, 2)
  generatedAt     DateTime @default(now()) @map("generated_at")
  generatedBy     Int      @map("generated_by")

  branch    Branch @relation(fields: [branchId], references: [branchId])
  generator User   @relation(fields: [generatedBy], references: [userId])

  @@map("FINANCIAL_REPORT")
}

model ReportSchedule {
  scheduleId     Int      @id @default(autoincrement()) @map("schedule_id")
  reportType     String   @map("report_type") @db.VarChar(50)
  frequency      String   @db.VarChar(20)
  day            Int?
  dailyTime      String   @map("daily_time") @db.VarChar(5)
  branchId       Int      @map("branch_id")
  emailRecipient String?  @map("email_recipient") @db.VarChar(255)
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [branchId])

  @@map("REPORT_SCHEDULE")
}

model ReportLog {
  logId        Int          @id @default(autoincrement()) @map("log_id")
  reportType   String       @map("report_type") @db.VarChar(50)
  reportId     Int?         @map("report_id")
  generatedBy  Int          @map("generated_by")
  generatedAt  DateTime     @default(now()) @map("generated_at")
  fileLocation String?      @map("file_location") @db.VarChar(255)
  status       ReportStatus @default(GENERATING)
  errorMessage String?      @map("error") @db.Text

  generator User @relation(fields: [generatedBy], references: [userId])

  @@map("REPORT_LOG")
}

// ─── Audit & Notifications ─────────────────────────────
model AuditLog {
  logId     Int      @id @default(autoincrement()) @map("log_id")
  userId    Int      @map("user_id")
  action    String   @db.VarChar(50)
  tableName String   @map("table_name") @db.VarChar(50)
  recordId  Int      @map("record_id")
  timestamp DateTime @default(now())
  ipAddress String?  @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [userId])

  @@map("AUDIT_LOG")
}

model Notification {
  notificationId Int              @id @default(autoincrement()) @map("notification_id")
  userId         Int              @map("user_id")
  type           NotificationType
  title          String           @db.VarChar(100)
  message        String           @db.Text
  isRead         Boolean          @default(false) @map("is_read")
  scheduledFor   DateTime         @map("scheduled_for")
  sentAt         DateTime?        @map("sent_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  user           User             @relation(fields: [userId], references: [userId])

  @@map("NOTIFICATIONS")
}

model Cart {
  cartId         Int       @id @default(autoincrement()) @map("cart_id")
  branchId       Int       @map("branch_id")
  posId          String?   @db.VarChar(50) @map("pos_id")
  sessionId      String?   @db.VarChar(50) @map("session_id")
  cashierId      Int       @map("cashier_id")
  customerId     Int?      @map("customer_id")
  status         String    @default("ACTIVE") @db.VarChar(20)
  discountType   String?   @db.VarChar(20) @map("discount_type")
  discountValue  Decimal?  @db.Decimal(10,2) @map("discount_value")
  discountReason String?   @db.Text @map("discount_reason")
  subtotal       Decimal   @default(0) @db.Decimal(10,2)
  discount       Decimal   @default(0) @db.Decimal(10,2)
  tax            Decimal   @default(0) @db.Decimal(10,2)
  total          Decimal   @default(0) @db.Decimal(10,2)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  branch         Branch    @relation(fields: [branchId], references: [branchId])
  cashier        User      @relation("CartCashier", fields: [cashierId], references: [userId])
  customer       Customer? @relation(fields: [customerId], references: [customerId])
  items          CartItem[]

  @@map("CARTS")
}

model CartItem {
  cartItemId Int      @id @default(autoincrement()) @map("cart_item_id")
  cartId     Int      @map("cart_id")
  productId  Int      @map("product_id")
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10,2) @map("unit_price")
  discount   Decimal  @default(0) @db.Decimal(10,2)
  tax        Decimal  @default(0) @db.Decimal(10,2)
  total      Decimal  @db.Decimal(10,2)
  createdAt  DateTime @default(now()) @map("created_at")

  cart       Cart     @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [productId])

  @@unique([cartId, productId])
  @@map("CART_ITEMS")
}